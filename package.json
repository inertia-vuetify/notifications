{
    "name": "@inertia-vuetify/notifications",
    "version": "3.0.0",
    "description": "Display Inertia flash messages using Vuetify snackbars",
    "type": "module",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "default": "./dist/index.js"
        }
    },
    "files": [
        "dist"
    ],
    "sideEffects": false,
    "scripts": {
        "dev": "vite build --watch",
        "build": "vue-tsc --noEmit && vite build",
        "typecheck": "vue-tsc --noEmit",
        "test": "vitest run",
        "test:watch": "vitest",
        "lint:package": "publint --strict && attw --pack . --profile esm-only"
    },
    "peerDependencies": {
        "@inertiajs/vue3": "^3.0.0",
        "vue": "^3.5.0",
        "vuetify": "^4.0.0"
    },
    "devDependencies": {
        "@arethetypeswrong/cli": "^0.18.5",
        "@inertiajs/vue3": "^3.9.1",
        "@microsoft/api-extractor": "^7.60.0",
        "@types/node": "^24.19.2",
        "@vitejs/plugin-vue": "^6.0.10",
        "@vue/test-utils": "^2.5.1",
        "jsdom": "^30.1.3",
        "publint": "^0.3.25",
        "typescript": "^6.0.3",
        "vite": "^8.3.5",
        "vite-plugin-dts": "^5.1.2",
        "vitest": "^5.0.5",
        "vue": "^3.5.44",
        "vue-tsc": "^3.3.13",
        "vuetify": "^4.3.1"
    },
    "keywords": [
        "vue",
        "vuetify",
        "inertia",
        "notifications",
        "snackbar",
        "flash-messages"
    ],
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/inertia-vuetify/notifications.git"
    }
}
