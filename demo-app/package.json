{
    "$schema": "https://www.schemastore.org/package.json",
    "private": true,
    "type": "module",
    "scripts": {
        "build": "vite build",
        "build:ssr": "vite build && vite build --ssr",
        "dev": "vite",
        "dev:full": "concurrently \"npm run dev:package\" \"npm run dev\" --names \"package,demo\" --prefix-colors \"cyan,green\"",
        "dev:package": "cd .. && npm run dev",
        "serve": "php artisan serve --host=0.0.0.0",
        "format": "prettier --write resources/",
        "format:check": "prettier --check resources/",
        "lint": "eslint . --fix",
        "lint:check": "eslint .",
        "typecheck": "vue-tsc --noEmit"
    },
    "devDependencies": {
        "@laravel/vite-plugin-wayfinder": "^0.1.11",
        "@types/node": "^24.19.2",
        "@vue/eslint-config-typescript": "^14.9.0",
        "eslint": "^10.13.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-vue": "^10.12.0",
        "prettier": "^3.9.10",
        "prettier-plugin-organize-imports": "^4.3.0",
        "prettier-plugin-tailwindcss": "^0.8.1",
        "typescript-eslint": "^8.72.1",
        "vue-tsc": "^3.3.13"
    },
    "dependencies": {
        "@inertia-vuetify/notifications": "file:..",
        "@inertiajs/vite": "^3.9.1",
        "@inertiajs/vue3": "^3.9.1",
        "@mdi/font": "^7.4.47",
        "@tailwindcss/vite": "^4.3.3",
        "@vitejs/plugin-vue": "^6.0.10",
        "concurrently": "^10.0.6",
        "laravel-vite-plugin": "^3.2.0",
        "tailwindcss": "^4.3.3",
        "typescript": "^6.0.3",
        "vite": "^8.3.5",
        "vite-plugin-vuetify": "^2.1.3",
        "vue": "^3.5.44",
        "vuetify": "^4.3.1"
    },
    "optionalDependencies": {
        "@tailwindcss/oxide-linux-x64-gnu": "^4.0.1",
        "lightningcss-linux-x64-gnu": "^1.29.1"
    }
}
